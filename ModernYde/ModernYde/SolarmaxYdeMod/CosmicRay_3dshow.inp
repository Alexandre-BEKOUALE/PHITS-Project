$MPI=0
[ T i t l e ]
Sample input file for cosmic-ray transport simulation in Douala (Simulation of attenuation of Houses Takoukam)
$Type one house 

[ P a r a m e t e r s ]
 icntl = 11		# (D=0) 3:ECH 5:NOR 6:SRC 7,8:GSH 11:DSH 12:DUMP
 maxcas   =        5e06     # (D=10) number of particles per one batch
 maxbch   =         100     # (D=10) number of batches
 e-mode   =           2     # (D=0) 0: Normal, 1: Event generator mode Ver.1, 2: Ver.2
 irqmd    =           1     # (D=0) 0: JQMD legacy version, 1: JQMD-2.0
 negs     =           1     # (D=-1) =-1:original, =0:No, =1:EGS
 mdbatima =        3000     # (D=500) max database size of ATIMA
 maxbnk   =      100000     # (D=10000) maximum bank memory length
 iMeVperU =           1     # (D=0) 0:[MeV] or 1:[MeV/u] is unit of tally output
 emin(12) =  1.00000000     # (D=1.e+9) cut-off energy of electron (MeV)
 emin(13) =  1.00000000     # (D=1.e+9) cut-off energy of positron (MeV)
 emin(14) =  1.00000000     # (D=1.0e-3) cut-off energy of photon (MeV)
 dmax(12) =  1000000.00     # (D=emin(12)) data max. energy of electron (MeV)
 dmax(13) =  1000000.00     # (D=emin(13)) data max. energy of positron (MeV)
 dmax(14) =  1000000.00     # (D=1.0e+3) data max. energy of photon (MeV)
 file(1) = C:/phits
 file(6)  = phits.out       # (D=phits.out) general output file name

[ S o u r c e ]
set:c1[2500.0]  	$ Source radius

totfact =  -pi*c1**2       # (D=1.0) global factor
infl:{source.inp}
     proj =  neutron
infl:{source.inp}
     proj =  muon+
infl:{source.inp}
     proj =  muon-
infl:{source.inp}
     proj =  electron
infl:{source.inp}
     proj =  positron
infl:{source.inp}
     proj =  photon

	 
	 
[ M a t e r i a l ]

$ Air D = 1.21e-3 g/cm3
MAT[1]  1H   7.199E-09
        12C  7.585E-09
        14N  3.910E-05
        16O  1.054E-05

$ zinc for Al roof D = 7.14 g/cm3
MAT[2]  Zn  1.0

$ Concrete D = 2.2 g/cm3 for dense concrete an 2.0 for light concrete
MAT[3]  1H    1.3407e-2
        12C   1.1030e-3
        16O   4.3887e-2
        27Al  1.7971e-3
        28Si  1.6123e-2
        40Ca  1.8940e-3
        56Fe  3.3448e-4

$ Wood D = 0.54 g/cm3  corresponding to Gum Ecaliptus https://www.engineeringtoolbox.com/wood-density-d_40.html
MAT[4]  12C  -0.48
		16O  -0.44
		1H   -0.06
		14N  -0.008
		32S  -0.007
		40Ca -0.002
		39K  -0.001
		55Mn -0.001
		31P  -0.001

MAT[ 5 ]  $ Ground
           Si 1.0  O 2.0

MAT[6]  $ Straw for roof/ceiling 		d(g/cm3)=0.24
		Mg	-0.0002
		Si	-0.0083
		P	-0.00014
		Si	-0.00092
		K	-0.0015
		Ca	-0.0011
		N	-0.00225
		C	-0.5035
		O	-0.42709
		H	-0.05401
		Fe	-0.00099

MAT[7]  $ Rafia bamboo for roof/ceiling 		d(g/cm3)=0.7
		C 4.313 H 4.94 O 2.635 N 0.022 S 0.026

MAT[8]  $ clay brick for walls 		d(g/cm3)= 2.188
		Si		-0.233333333
		Al		-0.079411765
		Fe		-0.084
		Ca		-0.035714286
		Mg		-0.024
		K		-0.024893617
		Na		-0.01483871
		P		-0.008732394
		Mn		-0.015492958
		Zn		-0.008024691
		S		-0.04
		O		-0.431558246



[ Mat Name Color ]
    mat   name      color
     1    Air        pastelblue
     2    Zinc       cyan
     3    Concrete   pink
     4    Wood       camel
     5    Ground     gray
	 6	  Straw		 yellow
	 7    Rafia		 purple
	 8	ClayBrick	 orange
	 
	 
[ C e l l ]
 1   0        	-1 11 12  #3 	 $ air outside the room for dose cal
 2   0				 1  -2 	$20 22 #15
 3   0          2  -99  $20 22 #15
 $1   1 -1.21e-3  	-1 13 20 22 15	 $ air outside the room for dose cal
 $2   0				 1  -2 	$20 22 #15
$ 3   1 -1.21e-3      2  -99  $20 22 #15
 
 10  1 -1.21e-3 	-10					$ air inside the room for dose cal
 11  3 -2.2  		 10 -11  			$ concrete cover walls (crepissage)
 12  5 -1.9 	 	-12 -1				$ ground
 
 99 -1          99  			$ outer region

[ S u r f a c e ]		$ first floor of concrete house. Square Room of 5 m lenght and 2.5 m height
 set:c10[250.0]   		$ Heigh of the house
 set:c11[30.0]    		$ Ceiling height
 
 set:c12[500.0/2] 		$ Room interior length LONGUEUR
 set:c13[c12+2.0]   	$ inner/outer wall concrete cover thickness or radius
 set:c14[c13+20.0] 		$ wall thickness or radius
 set:c15[c14+2.0]  		$ center to outer wall concrete cover or radius

  1  so  1500.
 2  so  1510.
99  so  c1+0.1   

$1  so  4*c15+2*c10
 $2  so  4*c15+2*c10+20.
$99  so  c1+1  

10     rpp    -c12  c12   -c12   c12   0.0   c10            	$ air inside the room
11	   rpp    -c15  c15   -c15   c15   0.0   c10+c11       		$ light concrete walls
12	   pz     0.0 												$ ground separation



[ T - T r a c k ]
    title = Track Detection in reg mesh
     mesh =  reg            # mesh type is region-wise
      reg =    1 10
   volume 
      reg  vol
        1  8.4309E+09
        10 6.2500E+7
   e-type =    3            # e-mesh is log given by emin, emax and ne
       ne =   120            # number of e-mesh points
     emin =   1.000000      # minimum value of e-mesh points
     emax =   1.0e6      # maximum value of e-mesh points
     unit =    2            # unit is [1/cm^2/MeV/source]
     axis =   eng            # axis of output
     file = track_reg.out  # file name of output for the above axis
$     part =  proton alpha fe 
     part = all proton neutron muon+ muon- electron positron photon
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
   epsout =    1            # (D=0) generate eps file by ANGEL
 y-txt    = Flux [1/cm^2/(MeV/n)/sec]

[ T - T r a c k ]
    title = Cosmic-ray flux
     mesh =  xyz            # mesh type is xyz scoring mesh
   x-type =    2            # In the case of rotating figure, x & z data should be replaced by each other
     xmin =  -c1            # minimum value of x-mesh points
     xmax =   c1            # maximum value of x-mesh points
       nx =    200          # number of x-mesh points
   y-type =    2            # y-mesh is linear given by ymin, ymax and ny
     ymin =  -10            # minimum value of y-mesh points
     ymax =   10            # maximum value of y-mesh points
       ny =    1            # number of y-mesh points
   z-type =    2            # In the case of rotating figure, x & z data should be replaced by each other
     zmin =  -c1            # minimum value of z-mesh points
     zmax =   c1            # maximum value of z-mesh points
       nz =    200          # number of z-mesh points
  2D-type =    3            # 1:Cont, 2:Clust, 3:Color, 4:xyz, 5:mat, 6:Clust+Cont, 7:Col+Cont
     axis =   xz            # axis of output
     file = track_xz.out       # file name of output for the above axis
     part = all neutron photon proton (muon+ muon-) (electron positron) 
   e-type =    1            # e-mesh is given by the below data
       ne =    1            # number of e-mesh points
             0.0  1e10
     unit =    1            # unit is [1/cm^2/source]
   epsout =    1            # (D=0) generate eps file by ANGEL   
    gshow =    1            # 0: no 1:bnd, 2:bnd+mat, 3:bnd+reg 4:bnd+lat
    z-txt = Flux [/cm2/sec]
$ Rotating figure by 90 degree
     trcl = 0 0 0 0 0 1 0 1 0 1 0 0
    x-txt = x [cm]
    y-txt = z [cm]

[ T - T r a c k ]
    title = Track Detection in reg mesh
     mesh =  reg            # mesh type is region-wise
      reg =    1 10
   volume 
      reg  vol
        1  8.4309E+09
        10 6.2500E+7
   e-type =    1            # e-mesh is log given by emin, emax and ne
       ne =    1            # number of e-mesh points
       0.0  1.0e10
     unit =    1            # unit is [1/cm^2/source]
     axis =   reg           # axis of output
     file = track_dose.out  # file name of output for the above axis
     part =  all proton neutron photon muon+ muon- electron positron 
 multiplier = all
   mat   mset1
   all  (1.0e-6*24*3600  -211 )      # -211 is for effective dose equivalent for male
 y-txt    = Dose equivalent [uSv/day]

[ T - V o l u m e ]
     mesh =  reg
      reg = 1 10
     file = volume.out
   s-type =   1
       x0 =  0
       y0 =  0
       z0 =  0
       r0 =  2300
   stdcut =   0.0001

[ T - 3Dshow ]
   output =    3
       x0 =  0.
       y0 =  0.
       z0 =  125.
    e-the =   60.
    e-phi =   30.
    e-dst =  3000.
    l-the =   60.
    l-phi =   30.
    l-dst =  3000.
    w-wdt =   1500.
    w-hgt =   1500.
    w-dst =   1000.
   heaven =   z
     line =    1
   shadow =    2
    resol =    3
     file = house_3d.out
    title = 3D visualization SolarMax
   epsout =    1
[END]

